#!/bin/sh
set -eu

VERSION_FILE="/usr/share/sphinxpi/version"
VERSION="unknown"
[ ! -r "$VERSION_FILE" ] || VERSION=$(cat "$VERSION_FILE")
LIB_DIR="/usr/lib/sphinxpi"

show_help() {
    cat <<'EOF'
SphinxPi - Raspberry Pi system tools

Usage:
  sphinx help             Show this help
  sphinx version          Show installed version
  sphinx update           Download and install the latest GitHub version
  sphinx info             Show system information
  sphinx network-check    Diagnose network and APT connectivity
  sphinx desktop-install  Install optional LXDE desktop (root required)
  sphinx desktop          Start LXDE (normal user session)
  sphinx desktop-layout   Move LXPanel to the top
  sphinx archive-install  Install optional archive tools (root required)
  sphinx archive          Open Archive Manager
  sphinx dev              Open Development Manager
  sphinx python           Open Python Manager
  sphinx node             Open Node.js Manager
  sphinx tools            Open Developer Tools Manager
  sphinx doctor           Run system diagnostics
  sphinx system           Open System Manager
  sphinx monitor          Open Resource Monitor
  sphinx backup           Open Backup Manager
  sphinx network          Open Network Manager
  sphinx services         Open Service Manager
  sphinx logs             Open Log Viewer
  sphinx apps             Search and install 100+ Debian apps
  sphinx uninstall        Remove SphinxPi (add -f for full system removal)
  sphinx ui               Open the SphinxPi management menu

Normal Debian package commands:
  sudo apt install ./sphinxpi_VERSION_all.deb
  sudo apt remove sphinxpi
  sudo apt purge sphinxpi

Use sudo for administrative commands when logged in as a normal user.
EOF
}

run_helper() {
    helper=$1
    shift
    path="$LIB_DIR/$helper"
    if [ ! -r "$path" ]; then
        echo "SphinxPi helper is missing or unreadable: $path" >&2
        echo "Repair the package with: sudo apt install --reinstall sphinxpi" >&2
        exit 1
    fi
    # Run through /bin/sh instead of executing the helper directly. This
    # also works on systems where /usr is mounted with the noexec option.
    exec sh "$path" "$@"
}

case "${1:-help}" in
    help|-h|--help) show_help ;;
    version|-v|--version) echo "SphinxPi $VERSION" ;;
    info)
        echo "SphinxPi $VERSION"
        echo "OS: $(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-unknown}")"
        echo "Kernel: $(uname -r)"
        echo "Machine: $(uname -m)"
        echo "Debian architecture: $(dpkg --print-architecture 2>/dev/null || echo unknown)"
        echo "Hostname: $(hostname)"
        if [ -r /proc/device-tree/model ]; then
            printf "Hardware: "
            tr -d '\000' </proc/device-tree/model
            printf '\n'
        fi
        awk '/MemTotal|MemAvailable/ {print $1, int($2/1024) " MB"}' /proc/meminfo 2>/dev/null || true
        df -h /
        ;;
    network-check)
        echo "[Clock]"
        date
        echo
        echo "[Default route]"
        if command -v ip >/dev/null 2>&1; then ip route show default || true; else echo "ip command unavailable"; fi
        echo
        echo "[DNS: deb.debian.org]"
        if command -v getent >/dev/null 2>&1; then getent ahosts deb.debian.org || echo "DNS lookup failed"; else echo "getent unavailable"; fi
        echo
        echo "[HTTPS]"
        if command -v curl >/dev/null 2>&1; then curl -4 -I --connect-timeout 8 --max-time 12 https://deb.debian.org/debian/ || echo "HTTPS test failed"; else echo "curl missing; install with: sudo apt install curl"; fi
        echo
        echo "[APT sources]"
        if [ -r /etc/apt/sources.list ]; then grep -Ev '^[[:space:]]*(#|$)' /etc/apt/sources.list || true; fi
        if [ -d /etc/apt/sources.list.d ]; then grep -RhsEv '^[[:space:]]*(#|$)' /etc/apt/sources.list.d --include='*.list' --include='*.sources' 2>/dev/null || true; fi
        ;;
    update)
        if [ "$(id -u)" -eq 0 ]; then
            run_helper update.sh
        elif command -v sudo >/dev/null 2>&1; then
            exec sudo sh "$LIB_DIR/update.sh"
        else
            echo "Run this command as root: sudo sphinx update" >&2
            exit 1
        fi
        ;;
    desktop-install) run_helper desktop-install.sh ;;
    desktop)
        if [ "$(id -u)" -eq 0 ]; then
            echo "Do not start LXDE as root. Log in as a normal user and run: sphinx desktop"
            exit 1
        fi
        if ! command -v startx >/dev/null 2>&1 || [ ! -x /usr/bin/startlxde ]; then
            echo "LXDE is not installed. Run 'sudo sphinx desktop-install' first."
            exit 1
        fi
        exec startx /usr/bin/startlxde
        ;;
    desktop-layout)
        if [ "$(id -u)" -eq 0 ]; then echo "Run this inside your normal user's LXDE session."; exit 1; fi
        run_helper desktop-layout.sh
        ;;
    archive-install) run_helper archive-install.sh ;;
    system|monitor|backup|network|services|logs|apps)
        mode=menu
        case "$1" in
            monitor|backup|network|services|logs|apps) mode="$1" ;;
        esac
        run_helper system-manager.sh "$mode"
        ;;
    dev|python|node|tools|doctor)
        mode=menu
        case "$1" in
            python) mode=python ;;
            node) mode=node ;;
            tools) mode=tools ;;
            doctor) mode=doctor ;;
        esac
        if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
            if ! command -v runuser >/dev/null 2>&1 || ! command -v getent >/dev/null 2>&1; then
                echo "Cannot launch the Development Manager for the sudo user: runuser/getent is missing." >&2
                exit 1
            fi
            user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
            [ -n "$user_home" ] || { echo "Could not determine the sudo user's home directory." >&2; exit 1; }
            exec runuser -u "$SUDO_USER" -- env HOME="$user_home" sh "$LIB_DIR/dev-manager.sh" "$mode"
        fi
        run_helper dev-manager.sh "$mode"
        ;;
    archive)
        if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
            if ! command -v runuser >/dev/null 2>&1 || ! command -v getent >/dev/null 2>&1; then
                echo "Cannot safely launch Archive Manager for the sudo user: runuser/getent is missing." >&2
                echo "Log in directly as root and run: sphinx archive" >&2
                exit 1
            fi
            user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
            if [ -z "$user_home" ]; then
                echo "Could not determine the home directory for sudo user '$SUDO_USER'." >&2
                exit 1
            fi
            exec runuser -u "$SUDO_USER" -- env HOME="$user_home" sh "$LIB_DIR/archive-manager.sh"
        fi
        run_helper archive-manager.sh
        ;;
    uninstall)
        mode=normal
        if [ "${2:-}" = "-f" ] || [ "${2:-}" = "--full" ]; then mode=full
        elif [ -n "${2:-}" ]; then echo 'Usage: sphinx uninstall [-f|--full]'; exit 2; fi
        if [ "$(id -u)" -eq 0 ]; then exec sh "$LIB_DIR/remove.sh" "$mode"
        elif command -v sudo >/dev/null 2>&1; then exec sudo sh "$LIB_DIR/remove.sh" "$mode"
        else echo 'Use: sudo sphinx uninstall [-f]'; exit 1; fi
        ;;
    ui)
        command -v whiptail >/dev/null 2>&1 || { echo 'Install the UI with: sudo apt install whiptail'; exit 1; }
        choice=$(whiptail --title 'SphinxPi Control Center' --menu 'Choose an action' 20 72 8 update 'Update SphinxPi' system 'System Manager' dev 'Development Manager' archive 'Archive Manager' remove 'Uninstall SphinxPi' full 'Full system removal' version 'Show installed version' 3>&1 1>&2 2>&3) || exit 0
        case "$choice" in update) exec "$0" update ;; system) exec "$0" system ;; dev) exec "$0" dev ;; archive) exec "$0" archive ;; remove) exec "$0" uninstall ;; full) exec "$0" uninstall -f ;; version) exec "$0" version ;; esac
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run 'sphinx help'." >&2
        exit 2
        ;;
esac
