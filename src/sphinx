#!/bin/sh
set -eu

VERSION_FILE="/etc/sphinxpi/version"
VERSION="0.1.0"
[ ! -r "$VERSION_FILE" ] || VERSION=$(cat "$VERSION_FILE")

show_help() {
    cat <<'EOF'
SphinxPi - Raspberry Pi system layer

Usage:
  sphinx help             Show this help
  sphinx version          Show SphinxPi version
  sphinx info             Show system and hardware information
  sphinx network-check    Diagnose network, DNS and Debian HTTPS access
  sphinx desktop-install Install the lightweight LXDE desktop (run as root;
                          use sudo from a normal user account)
  sphinx desktop          Start LXDE from a normal user account
  sphinx desktop-layout   Move the LXPanel to the top
  sphinx archive-install Install archive tools and the terminal menu (run as
                          root; use sudo from a normal user account)
  sphinx archive          Open the interactive Archive Manager
  sphinx uninstall        Remove SphinxPi command, helpers and configuration

The uninstall command requires root. It leaves optional desktop/archive packages
and personal files installed. The text login remains available.
EOF
}

show_info() {
    echo "SphinxPi $VERSION"
    echo "----------------"
    if [ -r /etc/os-release ]; then
        . /etc/os-release
        echo "OS: ${PRETTY_NAME:-unknown}"
    else
        echo "OS: unknown"
    fi
    echo "Kernel: $(uname -r)"
    echo "Architecture: $(uname -m)"
    echo "Debian architecture: $(dpkg --print-architecture 2>/dev/null || echo unknown)"
    echo "Hostname: $(hostname)"
    if [ -r /proc/device-tree/model ]; then
        MODEL=$(tr -d '\000' </proc/device-tree/model)
        echo "Hardware: $MODEL"
    else
        echo "Hardware: unavailable"
    fi
    if [ -r /proc/meminfo ]; then
        awk '/MemTotal|MemAvailable/ {print $1, int($2/1024) " MB"}' /proc/meminfo
    fi
    echo "Root filesystem:"
    df -h /
}

network_check() {
    echo "SphinxPi network diagnostics (read-only)"
    echo "========================================"
    echo
    echo "[Clock]"
    date
    echo
    echo "[Default route]"
    if command -v ip >/dev/null 2>&1; then
        ip route show default || true
    else
        echo "ip command unavailable"
    fi
    echo
    echo "[DNS: deb.debian.org]"
    if command -v getent >/dev/null 2>&1; then
        getent ahosts deb.debian.org || echo "DNS lookup failed"
    else
        echo "getent unavailable"
    fi
    echo
    echo "[HTTPS over IPv4]"
    if command -v curl >/dev/null 2>&1; then
        curl -4 -I --connect-timeout 8 --max-time 12 https://deb.debian.org/debian/ || echo "IPv4 HTTPS test failed"
    else
        echo "curl unavailable; install it with: sudo apt install curl"
    fi
    echo
    echo "[APT source entries]"
    if [ -r /etc/apt/sources.list ]; then
        grep -Ev '^[[:space:]]*(#|$)' /etc/apt/sources.list || true
    fi
    if [ -d /etc/apt/sources.list.d ]; then
        grep -RhsEv '^[[:space:]]*(#|$)' /etc/apt/sources.list.d --include='*.list' --include='*.sources' 2>/dev/null || true
    fi
    echo
    echo "No network or repository settings were changed."
}

case "${1:-help}" in
    help|-h|--help) show_help ;;
    version|-v|--version) echo "SphinxPi $VERSION" ;;
    info) show_info ;;
    network-check) network_check ;;
    archive-install)
        [ -x /usr/lib/sphinxpi/archive-install.sh ] || { echo "Archive installer missing. Reinstall SphinxPi CLI."; exit 1; }
        exec /usr/lib/sphinxpi/archive-install.sh
        ;;
    uninstall)
        [ -x /usr/lib/sphinxpi/uninstall.sh ] || {
            echo "Installed uninstaller not found."
            echo "From the SphinxPi repository, run: sh scripts/uninstall.sh"
            exit 1
        }
        exec /usr/lib/sphinxpi/uninstall.sh
        ;;
    archive)
        if [ "$(id -u)" -eq 0 ]; then
            echo "Run the Archive Manager as your normal user, not root."
            exit 1
        fi
        [ -x /usr/lib/sphinxpi/archive-manager.sh ] || { echo "Archive Manager missing. Run sphinx archive-install as root, or sudo sphinx archive-install as a normal user."; exit 1; }
        exec /usr/lib/sphinxpi/archive-manager.sh
        ;;
    desktop-install)
        [ -x /usr/lib/sphinxpi/desktop-install.sh ] || { echo "Desktop installer missing. Reinstall SphinxPi CLI."; exit 1; }
        exec /usr/lib/sphinxpi/desktop-install.sh
        ;;
    desktop)
        if [ "$(id -u)" -eq 0 ]; then
            echo "Do not start a graphical desktop as root."
            echo "Create/log in to a normal user account, then run: sphinx desktop"
            exit 1
        fi
        if ! command -v startx >/dev/null 2>&1 || [ ! -x /usr/bin/startlxde ]; then
            echo "LXDE is not installed. Run sphinx desktop-install as root, or sudo sphinx desktop-install as a normal user."
            exit 1
        fi
        exec startx /usr/bin/startlxde
        ;;
    desktop-layout)
        if [ "$(id -u)" -eq 0 ]; then
            echo "Run this command from your normal user's LXDE session, not as root."
            exit 1
        fi
        [ -x /usr/lib/sphinxpi/desktop-layout.sh ] || { echo "Desktop layout helper missing. Reinstall SphinxPi CLI."; exit 1; }
        exec /usr/lib/sphinxpi/desktop-layout.sh
        ;;
    *)
        echo "Unknown or not-yet-implemented command: $1" >&2
        echo "Run 'sphinx help'." >&2
        exit 2
        ;;
esac
